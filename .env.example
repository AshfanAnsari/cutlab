# CutLab — server-side environment (worker + edge functions only).
# NEVER put the service-role key in the client. The browser app uses
# only the public publishable key (src/services/supabase.ts).

# Your Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Service-role key — edge functions (cutlab-mcp, cutlab-account) and
# server/worker.py. Bypasses RLS; keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the owner account's Supabase Auth user id. The MCP server
# exempts this account from the 2-project beta cap, and the client
# enables its owner-only live-control surface for it.
CUTLAB_OWNER_UID=

# Optional: an OpenAI-compatible free-LLM endpoint used by the
# prompt-edit lane on the worker (server/llm_lane.py).
FREELLMAPI_URL=
FREELLMAPI_KEY=
